{
  "name": "supermarket-pos",
  "version": "80.6.48",
  "description": "Cross-platform Supermarket POS System",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "postinstall": "electron-builder install-app-deps",
    "preview:receipt": "node tools/preview-receipt.js",
    "inspect:customer-display": "node tools/inspect-customer-display-format.js",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:win:x64": "electron-builder --win --x64",
    "build:all": "electron-builder -mw"
  },
  "keywords": [
    "pos",
    "supermarket",
    "electron",
    "desktop"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.9.1",
    "electron-rebuild": "^3.2.9"
  },
  "dependencies": {
    "@serialport/parser-readline": "^13.0.0",
    "better-sqlite3": "^11.10.0",
    "bwip-js": "^4.6.0",
    "iconv-lite": "^0.6.3",
    "jsbarcode": "^3.11.6",
    "serialport": "^13.0.0"
  },
  "build": {
    "appId": "com.supermarket.pos",
    "productName": "Supermarket POS",
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.business",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "supermarket_pos_v${version}_${arch}.${ext}",
      "requestedExecutionLevel": "asInvoker"
    },
    "files": [
      "main.js",
      "renderer/**/*",
      "database.js",
      "customer-display.js",
      "preload.js",
      "customer-display-preload.js",
      "node_modules/**/*",
      "!node_modules/@serialport/bindings-cpp/build/**",
      "!pos_system.db",
      "!pos_database.db"
    ],
    "asarUnpack": [
      "**/*.node",
      "node_modules/serialport/**",
      "node_modules/@serialport/**"
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "allowElevation": true,
      "artifactName": "supermarket_pos_v${version}_nsis_${arch}.${ext}"
    },
    "portable": {
      "artifactName": "supermarket_pos_v${version}_portable_${arch}.${ext}"
    }
  }
}
